{
  "uid": "k3s-logs",
  "title": "K3s Logs",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "tags": [
    "homelab",
    "logs",
    "k3s"
  ],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "weekStart": "",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "uid": "loki",
          "type": "loki"
        },
        "query": "label_values(namespace)",
        "regex": "",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "uid": "loki",
          "type": "loki"
        },
        "query": "label_values(pod{namespace=~\"$namespace\"})",
        "regex": "",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "uid": "loki",
          "type": "loki"
        },
        "query": "label_values(container{namespace=~\"$namespace\", pod=~\"$pod\"})",
        "regex": "",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Pod logs",
      "datasource": {
        "uid": "loki",
        "type": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 20
      },
      "targets": [
        {
          "expr": "{cluster=\"homelab\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"}",
          "refId": "A",
          "datasource": {
            "uid": "loki",
            "type": "loki"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {}
      }
    }
  ]
}
